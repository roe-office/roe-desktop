    // 错误警报框放在设置框之后 = 更上层
    DataValidationErrorDialog {
        x: 0px; y: 0px;
        width: parent.width;
        height: parent.height;
        visible-dialog: root.dv-err-visible;
        message: root.dv-err-message;
        show-cancel: root.dv-err-show-cancel;
        confirmed => {
            // 确定:关弹窗,回到编辑态。守卫已 return,calc-editing 与 cell-edit.text 均未被改动
            root.dv-err-visible = false;
            root.dv-err-confirmed();
            cell-edit.focus();
        }
        cancelled => {
            // 取消:关弹窗并放弃输入(同 Esc 分支)
            root.dv-err-visible = false;
            root.dv-err-cancelled();
            root.calc-editing = false;
            cell-edit.text = "";
            root.calc-display-value = root.calc-edit-original;
            root.formula-cancelled();
            cell-edit.focus();
        }
    }


    // ── 窗口八向缩放热区（后声明 = 最上层） ──
    EdgeZone { x: 12px; y: 0px; width: root.width - 24px; height: 4px; dir: 0; mouse-cursor: MouseCursor.n-resize; start(d) => { root.window-resize-started(d); } }
    EdgeZone { x: 12px; y: root.height - 4px; width: root.width - 24px; height: 4px; dir: 1; mouse-cursor: MouseCursor.s-resize; start(d) => { root.window-resize-started(d); } }
    EdgeZone { x: 0px; y: 12px; width: 4px; height: root.height - 24px; dir: 2; mouse-cursor: MouseCursor.w-resize; start(d) => { root.window-resize-started(d); } }
    EdgeZone { x: root.width - 4px; y: 12px; width: 4px; height: root.height - 24px; dir: 3; mouse-cursor: MouseCursor.e-resize; start(d) => { root.window-resize-started(d); } }
    EdgeZone { x: 0px; y: 0px; width: 12px; height: 12px; dir: 4; mouse-cursor: MouseCursor.nw-resize; start(d) => { root.window-resize-started(d); } }
    EdgeZone { x: root.width - 12px; y: 0px; width: 12px; height: 12px; dir: 5; mouse-cursor: MouseCursor.ne-resize; start(d) => { root.window-resize-started(d); } }
    EdgeZone { x: 0px; y: root.height - 12px; width: 12px; height: 12px; dir: 6; mouse-cursor: MouseCursor.sw-resize; start(d) => { root.window-resize-started(d); } }
    EdgeZone { x: root.width - 12px; y: root.height - 12px; width: 12px; height: 12px; dir: 7; mouse-cursor: MouseCursor.se-resize; start(d) => { root.window-resize-started(d); } }
}
