        kind <=> root.impress-ph-kind;
        confirmed => { root.impress-ph-visible = false; if (root.impress-ph-kind != "") { root.impress-master-ph-apply(root.impress-ph-kind); } }
        cancelled => { root.impress-ph-visible = false; }
