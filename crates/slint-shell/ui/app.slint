// 选区高亮矩形（拖拽选区，本次新增）。用具名struct而非匿名struct数组，
// 保证Slint生成的Rust类型名固定为SelectionRect，避免匿名struct自动命名的不确定性。
export struct SelectionRect {
    rx: length,
    ry: length,
    rw: length,
    rh: length,
}


// 批注气泡数据（ROE_Progress_v158 第二节新增接口对应的前端展示结构）。
// 坐标基准：文档坐标系pt（不含scroll偏移），与SelectionRect的rx/ry同一套换算方式。
// author/text 来自 roe_get_comment_threads 的纯文本内容（本阶段不支持富文本，
// 见v158 2.1节"BodyElement富文本本次不做"）。
export struct CommentReply {
    id: int,
    author: string,
    date: string,
    text: string,
}

export struct CommentBubble {
    rx: length,
    ry: length,
    // anchor-ry：批注锚点在文档坐标系里的原始y（避让前，不随堆叠算法调整），
    // 用于画气泡与锚点之间的连接线（v160重叠修复新增，见ROE_Progress_v161）。
    // ry字段本身在有避让发生时会被Rust端下推调整，anchor-ry始终等于原始line_top_pt。
    anchor-ry: length,
    rw: length,
    rh: length,
    comment-id: int,
    color-idx: int,
    author: string,
    date: string,
    text: string,
    avatar-initials: string,
    done: bool,
    replies: [CommentReply],
}

component StartPageTitleBar inherits Rectangle {
    callback drag-started(length, length);
    callback drag-moved(length, length);
    callback double-clicked();
    callback minimize-clicked();
    callback maximize-clicked();
    callback close-clicked();

    height: 36px;
    background: #5E60A8;

    // 拖拽区（标题栏空白处，排除右侧窗口按钮区）
    TouchArea {
        x: 0px;
        width: parent.width - 138px;
        height: parent.height;
        property <bool> drag-fired: false;
        moved => {
            if (self.pressed && !self.drag-fired
                && (Math.abs((self.mouse-x - self.pressed-x) / 1px) > 4
                    || Math.abs((self.mouse-y - self.pressed-y) / 1px) > 4)) {
                self.drag-fired = true;
                root.drag-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.drag-fired = false;
                root.drag-started(self.mouse-x, self.mouse-y);
            }
        }
        double-clicked => { root.double-clicked(); }
    }

    // 居中标题
    Text {
        text: "roe-office";
        color: white;
        font-size: 13px;
        x: (parent.width - self.width) / 2;
        vertical-alignment: center;
        height: parent.height;
    }

    // 右侧窗口按钮
    HorizontalLayout {
        x: parent.width - 138px;
        width: 138px;
        height: parent.height;
        spacing: 0px;

        min-btn := TouchArea {
            width: 46px; height: 36px;
            clicked => { root.minimize-clicked(); }
            Rectangle {
                background: min-btn.has-hover ? #7B7DC0 : transparent;
                Image { source: @image-url("icons/fluent/win_minimize.svg"); width: 16px; height: 16px; }
            }
        }
        max-btn := TouchArea {
            width: 46px; height: 36px;
            clicked => { root.maximize-clicked(); }
            Rectangle {
                background: max-btn.has-hover ? #7B7DC0 : transparent;
                Image { source: @image-url("icons/fluent/win_maximize.svg"); width: 16px; height: 16px; }
            }
        }
        close-btn := TouchArea {
            width: 46px; height: 36px;
            clicked => { root.close-clicked(); }
            Rectangle {
                background: close-btn.has-hover ? #c42b1c : transparent;
                Image { source: @image-url("icons/fluent/win_close.svg"); width: 16px; height: 16px; }
            }
        }
    }
}

component TitleBar inherits Rectangle {
    in property <string> doc-type: "";
    in property <bool> auto-save-on: true;
    in property <string> file-name: "";
    in property <bool> settings-mode: false;

    callback drag-started(length, length);
    callback drag-moved(length, length);
    callback double-clicked();
    callback minimize-clicked();
    callback maximize-clicked();
    callback close-clicked();
    callback home-clicked();
    callback open-file-clicked();
    callback writer-key-input(string);  // 键盘字符输入
    // v95新增：方向键光标移动。参数：key(Left/Right/Up/Down的字符串标识)，
    // shift(是否按住shift，用于扩展选区)，ctrl(是否按住ctrl，用于按词移动)。
    callback writer-cursor-key(string, bool, bool);
    callback writer-click(float, float);  // 点击坐标(x,y)，文档坐标系pt
    callback save-clicked();
    callback print-clicked();
    callback undo-clicked();
    callback redo-clicked();
    callback ai-clicked();
    in-out property <bool> ai-panel-visible: false;
    callback auto-save-toggled(bool);

    height: 36px;

    background: root.settings-mode ? #5E60A8 : root.doc-type == "calc" ? #217346
        : root.doc-type == "impress" ? #c43e1b
        : root.doc-type == "agent" ? #5E60A8
        : #2b579a;

    function accent-light() -> color {
        return root.doc-type == "calc" ? #32ae6a
            : root.doc-type == "impress" ? #e66746
            : root.doc-type == "agent" ? #7B7DC0
            : #467bcb;
    }
    function divider-color() -> color {
        return root.accent-light();
    }

    // 拖拽区（标题栏空白处，排除右侧按钮区）
    drag-area := TouchArea {
        x: 0px;
        width: parent.width - 350px; // 留出左侧功能按钮 + 右侧AI/窗口按钮的大致宽度
        height: parent.height;
        property <bool> drag-fired: false;
        moved => {
            if (self.pressed && !self.drag-fired
                && (Math.abs((self.mouse-x - self.pressed-x) / 1px) > 4
                    || Math.abs((self.mouse-y - self.pressed-y) / 1px) > 4)) {
                self.drag-fired = true;
                root.drag-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.drag-fired = false;
                root.drag-started(self.mouse-x, self.mouse-y);
            }
        }
        double-clicked => { root.double-clicked(); }
    }

    // ── 左侧快速访问栏（agent模式下隐藏，见v82精简分支） ──
    HorizontalLayout {
        visible: root.doc-type != "agent";
        x: 8px;
        y: 0px;
        height: parent.height;
        spacing: 4px;
        alignment: start;

        HorizontalLayout {
            spacing: 5px;
            alignment: center;
            y: (parent.height - self.height) / 2;
            Text {
                text: @tr("自动保存");
                color: white;
                font-size: 11px;
                vertical-alignment: center;
            }
            autosave-toggle := TouchArea {
                width: 32px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.auto-save-toggled(!root.auto-save-on);
                }
                Image {
                    source: root.auto-save-on
                        ? @image-url("icons/fluent/toggle_right.svg")
                        : @image-url("icons/fluent/toggle_left.svg");
                    width: 32px;
                    height: 20px;
                    image-fit: contain;
                }
            }
        }

        Rectangle { width: 1px; height: 18px; y: (parent.height - self.height) / 2; background: root.divider-color(); }

        title-bar-btn := TouchArea {
            width: 28px; height: 26px;
            y: (parent.height - self.height) / 2;
            clicked => { root.home-clicked(); }
            Rectangle {
                background: title-bar-btn.has-hover ? root.accent-light() : transparent;
                border-radius: 3px;
                Image { source: @image-url("icons/fluent/home.svg"); width: 16px; height: 16px; }
            }
        }

        open-file-btn := TouchArea {
            width: 28px; height: 26px;
            y: (parent.height - self.height) / 2;
            clicked => { root.open-file-clicked(); }
            Rectangle {
                background: open-file-btn.has-hover ? root.accent-light() : transparent;
                border-radius: 3px;
                Image { source: @image-url("icons/fluent/ic_fluent_folder_open_20_filled.svg"); width: 16px; height: 16px; }
            }
        }

        save-btn := TouchArea {
            width: 28px; height: 26px;
            y: (parent.height - self.height) / 2;
            clicked => { root.save-clicked(); }
            Rectangle {
                background: save-btn.has-hover ? root.accent-light() : transparent;
                border-radius: 3px;
                Image { source: @image-url("icons/fluent/save.svg"); width: 16px; height: 16px; }
            }
        }

        print-btn := TouchArea {
            width: 28px; height: 26px;
            y: (parent.height - self.height) / 2;
            clicked => { root.print-clicked(); }
            Rectangle {
                background: print-btn.has-hover ? root.accent-light() : transparent;
                border-radius: 3px;
                Image { source: @image-url("icons/fluent/print.svg"); width: 16px; height: 16px; }
            }
        }

        Rectangle { width: 1px; height: 18px; background: root.divider-color(); }

        undo-btn := TouchArea {
            width: 28px; height: 26px;
            y: (parent.height - self.height) / 2;
            clicked => { root.undo-clicked(); }
            Rectangle {
                background: undo-btn.has-hover ? root.accent-light() : transparent;
                border-radius: 3px;
                Image { source: @image-url("icons/fluent/undo_white.svg"); width: 16px; height: 16px; }
            }
        }

        redo-btn := TouchArea {
            width: 28px; height: 26px;
            y: (parent.height - self.height) / 2;
            clicked => { root.redo-clicked(); }
            Rectangle {
                background: redo-btn.has-hover ? root.accent-light() : transparent;
                border-radius: 3px;
                Image { source: @image-url("icons/fluent/redo_white.svg"); width: 16px; height: 16px; }
            }
        }
    }

    // 居中标题
    Text {
        text: root.settings-mode ? @tr("设置") : (root.file-name != "" && root.doc-type != "agent") ? root.file-name : root.doc-type == "calc" ? "office-calc-rs"
            : root.doc-type == "impress" ? "office-impress-rs"
            : root.doc-type == "agent" ? @tr("AI Agent - 对话1")
            : "office-writer-rs";
        color: white;
        font-size: 13px;
        x: (parent.width - self.width) / 2;
        vertical-alignment: center;
        height: parent.height;
        animate x { duration: 150ms; }
    }

    // AI 按钮（agent模式下隐藏，见v82精简分支）
    ai-btn := TouchArea {
        visible: root.doc-type != "agent";
        width: 72px; height: 24px;
        x: parent.width - 138px - 15px - 72px; // 窗口按钮区(138px)左侧留15px间距
        y: (parent.height - self.height) / 2;
        clicked => { root.ai-clicked(); root.ai-panel-visible = !root.ai-panel-visible; }
        Rectangle {
            background: ai-btn.has-hover ? root.accent-light() : rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: "✦"; color: white; font-size: 12px; vertical-alignment: center; }
                Text { text: "AI"; color: white; font-size: 12px; font-weight: 600; vertical-alignment: center; }
            }
        }
    }

    // 右侧窗口按钮
    HorizontalLayout {
        x: parent.width - 138px;
        width: 138px;
        height: parent.height;
        spacing: 0px;

        min-btn := TouchArea {
            width: 46px; height: 36px;
            clicked => { root.minimize-clicked(); }
            Rectangle {
                background: min-btn.has-hover ? root.accent-light() : transparent;
                Image { source: @image-url("icons/fluent/win_minimize.svg"); width: 16px; height: 16px; }
            }
        }
        max-btn := TouchArea {
            width: 46px; height: 36px;
            clicked => { root.maximize-clicked(); }
            Rectangle {
                background: max-btn.has-hover ? root.accent-light() : transparent;
                Image { source: @image-url("icons/fluent/win_maximize.svg"); width: 16px; height: 16px; }
            }
        }
        close-btn := TouchArea {
            width: 46px; height: 36px;
            clicked => { root.close-clicked(); }
            Rectangle {
                background: close-btn.has-hover ? #c42b1c : transparent;
                Image { source: @image-url("icons/fluent/win_close.svg"); width: 16px; height: 16px; }
            }
        }
    }
}

// v112新增：WriterImeInput —— 独立的IME输入具名组件（继承内建TextInput）。
// 提升为独立component而不是内联具名实例，原因：
// - property/public function 是"类型定义"该有的特性，不是"具名实例"的语法用途；
// - 独立组件职责清晰、可单独复用，符合v112方案三.3的设计意图（该方案原始
//   示意代码就是以 component 形式给出的）。
// 内部不能再用 root.writer-ime-composed(...) 这种直接引用外层AppWindow的
// callback的写法（提升为独立组件后，组件内部的 root 指向的是
// WriterImeInput 自己，不再是 AppWindow）——改为组件自己声明 composed/
// enter-pressed 两个callback，由外层AppWindow在实例化处接住并转发。
component WriterImeInput inherits TextInput {
    // 防重入标志：clear-buffer() 内部会把 self.text 置空，这个赋值本身会
    // 再触发一次 edited 事件（ROE_Progress_v112.md 二.3 记录的教训——
    // "清空"看起来是纯粹的赋值动作，但因为它也是对 text 属性的一次赋值，
    // 会被自己的 edited 处理器听到，形成递归）。用这个标志拦截掉程序主动
    // 清空触发的递归 edited 事件，只放行用户真实输入触发的 edited。
    property <bool> is-clearing: false;

    // 组合结果变化时转发给外层（外层再决定是走"编辑会话"区间替换逻辑）。
    callback composed(string);
    // 回车键按下时转发给外层（外层复用已验证的 writer-key-input("\n") 路径）。
    callback enter-pressed();

    // 供外层（最终是Rust侧）调用的安全清空方法。安全指：调用方不需要
    // 关心"清空会不会打断正在进行的组合"这类细节，这里统一处理好防重入。
    public function clear-buffer() {
        self.is-clearing = true;
        self.text = "";
        self.is-clearing = false;
    }

    edited => {
        if (self.is-clearing) {
            return; // 拦截程序主动清空触发的递归edited事件
        }
        self.composed(self.text);
    }
    accepted => {
        // v112修复（原注释保留）：回车键在single-line(默认true)的TextInput上会
        // 触发accepted而不会到达key-pressed的Return分支（TextInput内部直接
        // 处理掉了），此前没有接这个回调，导致split_paragraph从未被调用，
        // 回车换行功能失效。这里转发给外层，外层复用已验证过的
        // writer-key-input("\n")路径，与writer-focus旧路径的分段逻辑保持一致，
        // 不重新发明。
        // 同时清空self.text，避免accepted之前已经通过edited累积的内容在
        // 下一次输入时被残留状态错误地重新插入。用clear-buffer()而不是直接
        // self.text=""，确保这次清空也受防重入保护，行为统一。
        self.enter-pressed();
        self.clear-buffer();
    }
    key-pressed(event) => {
        // v110路线A（观察阶段，参考Calc cell-edit的拦截范围收窄
        // 思路）：只拦截纯导航/控制类按键（方向键、Backspace/
        // Delete），普通字符/空格一律 reject，交给TextInput
        // 自己的默认行为处理——这样才能不打断IME组合/候选/
        // 确认的原生流程。
        if (event.text == Key.LeftArrow || event.text == Key.RightArrow
            || event.text == Key.UpArrow || event.text == Key.DownArrow) {
            root.composed-key-nav(event.text, event.modifiers.shift, event.modifiers.control);
            return accept;
        }
        if (event.text == Key.Return && event.modifiers.shift && !event.modifiers.control) {
            root.composed-format("writer.soft_break");
            return accept;
        }
        if (event.text == Key.Backspace || event.text == Key.Delete) {
            root.composed-key-nav(event.text, event.modifiers.shift, event.modifiers.control);
            return accept;
        }
        // v113新增：拦截Ctrl+Z（撤销）/ Ctrl+Shift+Z（重做）。
        // 根因（ROE_Progress_v113.md）：此前完全没有拦截这两个组合键，
        // Slint TextInput会用自己内置的撤销栈处理Ctrl+Z——直接把
        // self.text撤销回之前的状态（可能是空字符串），而这个变化又会
        // 触发edited事件，被外层on_writer_ime_composed当作"正常输入"
        // 提交给roe，等于把Slint自己的内部撤销误当成了一次真实编辑，
        // 结果是一次Ctrl+Z把roe文档里一大段内容整体删除，而不是真正
        // 调用roe内核已有的roe_undo/roe_redo（逐次编辑操作独立撤销）。
        // 用独立的composed-undo-redo回调转发，不复用composed-key-nav
        // （那个是方向键/删除键语义，混用容易在外层逻辑分支里产生歧义）。
        if (event.modifiers.control && !event.modifiers.shift && (event.text == "b" || event.text == "B")) {
            root.composed-format("writer.bold");
            return accept;
        }
        if (event.modifiers.control && !event.modifiers.shift && (event.text == "i" || event.text == "I")) {
            root.composed-format("writer.italic");
            return accept;
        }
        if (event.modifiers.control && !event.modifiers.shift && (event.text == "u" || event.text == "U")) {
            root.composed-format("writer.underline");
            return accept;
        }
        if (event.modifiers.control && !event.modifiers.shift && (event.text == "l" || event.text == "L")) {
            root.composed-format("writer.align_left");
            return accept;
        }
        if (event.modifiers.control && !event.modifiers.shift && (event.text == "e" || event.text == "E")) {
            root.composed-format("writer.align_center");
            return accept;
        }
        if (event.modifiers.control && !event.modifiers.shift && (event.text == "r" || event.text == "R")) {
            root.composed-format("writer.align_right");
            return accept;
        }
        if (event.modifiers.control && !event.modifiers.shift && (event.text == "j" || event.text == "J")) {
            root.composed-format("writer.align_justify");
            return accept;
        }
        if (event.text == Key.Tab || event.text == Key.Backtab) {
            if (root.tab-pressed(event.text == Key.Backtab || event.modifiers.shift)) { return accept; }
        }
        if (event.modifiers.control && event.text == "=") { root.composed-format("writer.sub"); return accept; }
        if (event.modifiers.control && event.text == "+") { root.composed-format("writer.super"); return accept; }
        if (event.modifiers.control && event.text == Key.Return) { root.composed-format("writer.page_break"); return accept; }
        if (event.modifiers.control && !event.modifiers.shift && (event.text == "f" || event.text == "F")) { root.composed-format("writer.find"); return accept; }
        if (event.modifiers.control && !event.modifiers.shift && (event.text == "h" || event.text == "H")) { root.composed-format("writer.replace"); return accept; }
        if (event.modifiers.control && !event.modifiers.shift && (event.text == "c" || event.text == "C")) { root.composed-format("writer.copy"); return accept; }
        if (event.modifiers.control && !event.modifiers.shift && (event.text == "x" || event.text == "X")) { root.composed-format("writer.cut"); return accept; }
        if (event.modifiers.control && !event.modifiers.shift && (event.text == "v" || event.text == "V")) { root.composed-format("writer.paste"); return accept; }
        if (event.modifiers.control && (event.text == "s" || event.text == "S")) {
            root.composed-save();
            return accept;
        }
        if (event.text == "z" || event.text == "Z") {
            if (event.modifiers.control && event.modifiers.shift) {
                root.composed-undo-redo(true); // true=redo
                return accept;
            }
            if (event.modifiers.control) {
                root.composed-undo-redo(false); // false=undo
                return accept;
            }
        }
        return reject;
    }
    // 方向键/Backspace/Delete 转发给外层（原代码直接调用
    // root.writer-cursor-key，提升为独立组件后同样需要改为自己的callback
    // 再由外层转发，不能再直接引用AppWindow的callback）。
    callback composed-key-nav(string, bool, bool);
    // v113新增：Ctrl+Z/Ctrl+Shift+Z 转发给外层。参数true=redo，false=undo。
    callback composed-undo-redo(bool);
    callback composed-save();
    callback composed-format(string);
    callback tab-pressed(bool) -> bool;
}

export struct FontItem { label: string, value: string }
// Calc 图表覆盖层:x/y/w/h=数据区容器内逻辑px;cx/cy/cw/ch=位图源像素裁剪
export struct FloatPic { x: length, y: length, w: length, h: length, cx: int, cy: int, cw: int, ch: int }

// 窗口边缘缩放热区：按下时通知 Rust 调用原生 drag_resize_window
component EdgeZone inherits TouchArea {
    in property <int> dir;
    callback start(int);
    pointer-event(e) => {
        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
            root.start(root.dir);
        }
    }
}

export component AppWindow inherits Window {
    // v112新增：供Rust侧调用的IME输入清空入口。转发给writer-ime-input
    // 具名子组件的clear-buffer()。Rust侧在方向键/鼠标点击/拖拽/回车等
    // "编辑会话结束"时机点调用 app.invoke_writer_ime_clear_buffer()。
    public function writer-ime-clear-buffer() {
        writer-ime-input.clear-buffer();
    }
    // v117新增：供Rust侧调用的IME输入聚焦入口，风格与上面的
    // writer-ime-clear-buffer一致。用于打开文档后主动让writer-ime-input
    // 获得焦点，行为等同于TouchArea.clicked里调用的writer-ime-input.focus()。
    public function writer-ime-focus() {
        writer-ime-input.focus();
    }
