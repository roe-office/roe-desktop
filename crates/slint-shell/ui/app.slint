    in-out property <bool> calc-fill-active: false;   // 正在拖拽填充柄
    in-out property <bool> calc-fill-show: false;     // 显示填充预览框
    in-out property <float> calc-fill-x: 0.0;         // 预览框(同 calc-range-x 坐标系)
    in-out property <float> calc-fill-y: 0.0;
    in-out property <float> calc-fill-w: 0.0;
    in-out property <float> calc-fill-h: 0.0;   // 是否正在拖拽选区
    callback calc-range-drag(float, float);        // 拖拽中，传鼠标坐标，Rust端更新选区范围
    callback calc-copy();                          // Ctrl+C：复制当前选区
    callback calc-paste();                         // Ctrl+V：粘贴到当前选中格
    callback calc-delete-cell();                   // Delete/Backspace：清空选中格内容（非编辑态）
    callback calc-undo-redo(bool);                 // Ctrl+Z / Ctrl+Shift+Z:Calc撤销/重做(true=redo)
    public function calc-clear-edit-buffer() { cell-edit.text = ""; }
    // 函数库插入:进入编辑态并写入文本,光标放到 cursor(UTF-8 字节偏移)。
    // 非编辑态进入时记下原值,Esc 可恢复;最后触发 formula-edited 以刷新补全/参数提示。
    public function calc-set-edit-text(t: string, cursor: int) {
        if !root.calc-editing { root.calc-edit-original = root.calc-display-value; }
        root.calc-editing = true;
        root.calc-display-value = t;
        cell-edit.text = t;
        cell-edit.focus();
        cell-edit.set-selection-offsets(cursor, cursor);
        root.formula-edited(t);
    }
    callback writer-tab(bool) -> bool;
    callback calc-add-sheet-requested();             // 用户点击SheetTabBar的+号，Rust端调roe新增sheet

