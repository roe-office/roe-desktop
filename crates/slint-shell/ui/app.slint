    // ── 下拉浮层 hover 延时自动关闭（颜色/字体名共用）──
    // popup-hover-count：浮层内所有 TouchArea 的 has-hover 汇总计数（>0 表示鼠标在浮层内）
    // popup-armed：鼠标至少进入过一次浮层后才启用自动关闭，避免从触发器移向浮层途中被误关
    property <int> popup-hover-count: 0;
    property <bool> popup-armed: false;
    function popup-hover-changed(h: bool) {
        if (h) {
            root.popup-armed = true;
            root.popup-hover-count += 1;
        } else if (root.popup-hover-count > 0) {
            root.popup-hover-count -= 1;
        }
    }
