            root.ribbon-action("writer.line_rule:" + root.line-dlg-mode + ":" + root.line-dlg-value + ":" + root.line-dlg-before + ":" + root.line-dlg-after);
        }
        cancelled => { root.line-dlg-visible = false; }
    }
    PageSetupDialog {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        visible-dialog <=> root.page-dlg-visible;
