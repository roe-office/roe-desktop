            root.ribbon-action("writer.page_setup:" + root.page-dlg-paper + ":" + root.page-dlg-orient + ":" + root.page-dlg-top + ":" + root.page-dlg-bottom + ":" + root.page-dlg-left + ":" + root.page-dlg-right + ":" + root.page-dlg-curw + ":" + root.page-dlg-curh);
