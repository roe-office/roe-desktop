// CalcViewport: 接收 roe_render_sheet_viewport 输出的整张 bitmap（含行号栏+列字母栏+数据区）
component CalcViewport {
    in property <image> viewport-image;
    Image {
        x: 0px; y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.viewport-image;
        image-fit: contain;
        image-rendering: pixelated;
    }
}
export { CalcViewport }
