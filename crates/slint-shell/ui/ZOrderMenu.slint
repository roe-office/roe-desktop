// 叠放次序右键菜单。组件铺满画布，px/py 为菜单左上角（画布 px）。
// 打开时底层有一层全屏透明遮罩，点菜单外任意位置关闭。
component ZItem inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 28px;
    background: ta.has-hover ? #dbe8fb : transparent;
    Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: #202020;
        font-size: 13px;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component ZOrderMenu inherits Rectangle {
    in property <bool> open: false;
    in property <float> px;
    in property <float> py;
    callback pick(string);
    callback dismiss();

    if root.open : TouchArea {
        x: 0px; y: 0px; width: root.width; height: root.height;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.dismiss(); }
        }
    }
    if root.open : Rectangle {
        x: Math.max(0px, Math.min(root.px * 1px, root.width - 150px));
        y: Math.max(0px, Math.min(root.py * 1px, root.height - 120px));
        width: 150px;
        height: 114px;
        background: #fdfdfd;
        border-width: 1px;
        border-color: #b8b8b8;
        VerticalLayout {
            padding: 1px;
            ZItem { label: @tr("置于顶层"); clicked => { root.pick("front"); } }
            ZItem { label: @tr("上移一层"); clicked => { root.pick("forward"); } }
            ZItem { label: @tr("下移一层"); clicked => { root.pick("backward"); } }
            ZItem { label: @tr("置于底层"); clicked => { root.pick("back"); } }
        }
    }
}
