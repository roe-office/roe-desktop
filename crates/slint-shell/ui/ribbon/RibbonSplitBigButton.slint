// 大按钮 + 下拉箭头的复合按钮（Split Button）。
// 点击主体区域触发 clicked()（默认动作，例如插入默认类型图表）；
// 点击右下角小箭头展开类型列表，视觉上贴着按钮正下方"长出来"，选中后触发 item-selected(index)。
// 参考 CalcRibbonInsert 图表按钮精简需求：插入图表默认Line，下拉选其他5种类型。
// v71修复：箭头从独占一行改为右下角小三角；展开列表改为紧贴按钮宽度、无独立浮窗观感。

export struct RibbonChartMenuItem {
    label: string,
    icon-source: image,
}

export component RibbonSplitBigButton inherits Rectangle {
    in property <image> icon-source;
    in property <string> label: "";
    in property <string> tooltip: "";
    in property <[RibbonChartMenuItem]> items: [];
    property <bool> is-open: false;

    callback clicked();
    callback item-selected(int);

    width: 48px;
    height: 62px;
    border-radius: 3px;
    border-width: root.is-open ? 1px : 0px;
    border-color: root.is-open ? #2b579a : transparent;
    background: mainTouch.pressed ? #d6d6d6
        : root.is-open ? #dde8f8
        : mainTouch.has-hover ? #ebebeb
        : transparent;

    VerticalLayout {
        alignment: center;
        spacing: 4px;
        padding: 4px;

        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon-source;
                width: 24px;
                height: 24px;
                image-fit: contain;
            }
        }

        Text {
            text: root.label;
            font-size: 10px;
            color: #333333;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    // 右下角小箭头标记，不独占布局行，仅作为角标叠放
    Text {
        text: "▾";
        font-size: 8px;
        color: #777777;
        x: parent.width - self.width - 3px;
        y: parent.height - self.height - 2px;
    }

    mainTouch := TouchArea {
        // 排除右下角箭头标记区域，避免点箭头也触发默认插入
        width: parent.width - 14px;
        height: parent.height - 10px;
        clicked => { root.clicked(); }
    }

    arrowTouch := TouchArea {
        x: parent.width - 14px;
        y: parent.height - 10px;
        width: 14px;
        height: 10px;
        clicked => {
            root.is-open = !root.is-open;
        }
    }

    // 展开列表：紧贴按钮正下方，宽度与按钮一致，覆盖在同行其他内容之上（z不需要手动设置，
    // 后声明的元素默认绘制在上层）。不使用PopupWindow，避免独立浮窗的边框/阴影观感，
    // 用普通Rectangle+visible实现"原地展开"效果。
    if root.is-open: Rectangle {
        x: 0px;
        y: root.height;
        width: max(root.width, 96px);
        height: list.preferred-height + 8px;
        background: white;
        border-color: #c8c8c8;
        border-width: 1px;
        border-radius: 3px;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000022;
        drop-shadow-offset-y: 1px;

        list := VerticalLayout {
            x: 0px;
            y: 4px;
            width: max(root.width, 96px);
            padding: 0px;
            spacing: 1px;

            for entry[idx] in root.items: Rectangle {
                height: 24px;
                border-radius: 3px;
                background: itemTouch.has-hover ? #e8f0fc : transparent;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 5px;
                    alignment: start;

                    Image {
                        source: entry.icon-source;
                        width: 14px;
                        height: 14px;
                        image-fit: contain;
                    }
                    Text {
                        text: entry.label;
                        font-size: 11px;
                        color: #222222;
                        vertical-alignment: center;
                    }
                }

                itemTouch := TouchArea {
                    clicked => {
                        root.is-open = false;
                        root.item-selected(idx);
                    }
                }
            }
        }
    }

    // 点击按钮外部区域收起展开列表
    if root.is-open: TouchArea {
        x: -1000px;
        y: -1000px;
        width: 3000px;
        height: 3000px;
        z: -1;
        clicked => { root.is-open = false; }
    }
}
