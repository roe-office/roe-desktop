component IconSetCell inherits Rectangle {
    in property <[int]> ids: [];
    in property <bool> selected: false;
    callback clicked();
    width: 190px;
    height: 28px;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.selected ? #217346 : transparent;
    background: root.selected ? #e3f1e8 : (cell-touch.has-hover ? #f0f0f0 : transparent);
    for id[i] in root.ids : IconGlyph {
        x: 10px + i * 21px;
        y: (parent.height - self.height) / 2;
        icon-id: id;
        glyph-size: 16px;
    }
    cell-touch := TouchArea { clicked => { root.clicked(); } }
}

export component CfIconSetPicker inherits Rectangle {
    in property <int> selected-index: -1;
    callback picked(int);
    width: 380px;
    height: 450px;
    background: transparent;
    Rectangle { x: 0px; y: 0px; width: 380px; height: 22px; background: #eef0f3;
