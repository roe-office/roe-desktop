// InsertChartDialog.slint — 插入图表弹窗
// 布局：左侧类型列表 + 右侧预览区 + 底部确定/取消
// 预览图由 Rust 调用 roe_render_chart_to_png 生成后通过 chart-preview-image 传入

export component InsertChartDialog inherits Rectangle {
    in-out property <bool> visible-dialog: false;
    in-out property <int> selected-type: 0;   // 0=Bar 1=Line 2=Pie 3=HorizontalBar 4=Scatter 5=Radar
    in-out property <string> chart-title: "";
    in property <image> chart-preview-image;

    callback confirmed(int, string);   // (chart-type-idx, title)
    callback cancelled();
    callback type-changed(int);        // 切换类型时触发Rust重新渲染预览

    background: transparent;
    visible: root.visible-dialog;

    // 半透明遮罩
    Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000040;

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.cancelled(); }
        }
    }

    // 弹窗主体
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 780px;
        height: 560px;
        background: #f5f5f5;
        border-radius: 8px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        drop-shadow-offset-y: 8px;

        // ── 标题栏 ──
        Rectangle {
            x: 0; y: 0;
            width: parent.width;
            height: 44px;
            background: #efefef;
            border-radius: 8px;
            // 底部不圆角（覆盖）
            Rectangle {
                x: 0; y: 22px;
                width: parent.width;
                height: 22px;
                background: #efefef;
            }
            Rectangle {
                x: 0; y: 43px;
                width: parent.width;
                height: 1px;
                background: #d8d8d8;
            }
            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: @tr("插入图表");
                font-size: 13px;
                font-weight: 600;
                color: #1a1a1a;
            }
            // 关闭按钮
            TouchArea {
                x: parent.width - 44px;
                y: 0;
                width: 44px;
                height: 44px;
                clicked => { root.cancelled(); }
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: parent.has-hover ? #00000015 : transparent;
                    Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: "✕";
                        font-size: 12px;
                        color: #555;
                    }
                }
            }
        }

        // ── 内容区 ──
        Rectangle {
            x: 0; y: 44px;
            width: parent.width;
            height: parent.height - 44px - 56px;

            // 左侧类型列表
            Rectangle {
                x: 0; y: 0;
                width: 180px;
                height: parent.height;
                background: white;
                Rectangle {
                    x: parent.width - 1px;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: #e0e0e0;
                }

                VerticalLayout {
                    x: 0; y: 8px;
                    width: parent.width;
                    spacing: 0px;

                    // 顺序与 ChartKind 枚举一致：Bar/HorizontalBar/Line/Pie/Scatter/Radar
                    for item[i] in [
                        {label: @tr("柱状图"),  icon: @image-url("icons/fluent/data_bar_vertical_regular.svg")},
                        {label: @tr("条形图"),  icon: @image-url("icons/fluent/data_bar_horizontal_regular.svg")},
                        {label: @tr("折线图"),  icon: @image-url("icons/fluent/data_line_filled.svg")},
                        {label: @tr("饼图"),    icon: @image-url("icons/fluent/data_pie_filled.svg")},
                        {label: @tr("散点图"),  icon: @image-url("icons/fluent/data_scatter_regular.svg")},
                        {label: @tr("雷达图"),  icon: @image-url("icons/fluent/data_area_filled.svg")},
                    ] : TouchArea {
                        height: 36px;
                        width: parent.width;
                        clicked => {
                            root.selected-type = i;
                            root.type-changed(i);
                        }
                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            background: root.selected-type == i ? #e8f4ee :
                                        parent.has-hover ? #f5f5f5 : transparent;
                            // 左侧选中条
                            Rectangle {
                                x: 0; y: 4px;
                                width: 3px;
                                height: parent.height - 8px;
                                border-radius: 2px;
                                background: root.selected-type == i ? #217346 : transparent;
                            }
                            Image {
                                x: 16px;
                                y: (parent.height - self.height) / 2;
                                width: 16px;
                                height: 16px;
                                source: item.icon;
                                colorize: root.selected-type == i ? #217346 : #555;
                            }
                            Text {
                                x: 40px;
                                y: (parent.height - self.height) / 2;
                                text: item.label;
                                font-size: 13px;
                                color: root.selected-type == i ? #217346 : #333;
                                font-weight: root.selected-type == i ? 600 : 400;
                            }
                        }
                    }
                }
            }

            // 右侧预览区
            Rectangle {
                x: 180px; y: 0;
                width: parent.width - 180px;
                height: parent.height;
                background: white;

                VerticalLayout {
                    x: 16px; y: 16px;
                    width: parent.width - 32px;
                    height: parent.height - 32px;
                    spacing: 12px;

                    // 标题输入
                    Rectangle {
                        height: 28px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text {
                                y: (parent.height - self.height) / 2;
                                text: @tr("图表标题：");
                                font-size: 12px;
                                color: #555;
                            }
                            Rectangle {
                                width: 200px;
                                height: 28px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #d0d0d0;
                                background: white;
                                TextInput {
                                    x: 8px;
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width - 16px;
                                    font-size: 12px;
                                    color: #1a1a1a;
                                    text <=> root.chart-title;
                                }
                            }
                        }
                    }

                    // 预览图
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #e8e8e8;
                        background: white;
                        clip: true;

                        if root.chart-preview-image.width > 0 : Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.chart-preview-image;
                            image-fit: contain;
                        }

                        if root.chart-preview-image.width == 0 : Rectangle {
                            width: parent.width;
                            height: parent.height;
                            background: #fafafa;
                            Text {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                text: @tr("预览加载中…");
                                font-size: 12px;
                                color: #aaa;
                            }
                        }
                    }
                }
            }
        }

        // ── 底部按钮栏 ──
        Rectangle {
            x: 0;
            y: parent.height - 56px;
            width: parent.width;
            height: 56px;
            background: #efefef;
            border-radius: 8px;
            Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: 22px;
                background: #efefef;
            }
            Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: 1px;
                background: #d8d8d8;
            }

            HorizontalLayout {
                x: (parent.width - 240px) / 2;
                y: (parent.height - 32px) / 2;
                width: 240px;
                height: 32px;
                spacing: 12px;

                // 确定
                TouchArea {
                    width: 114px;
                    height: 32px;
                    clicked => { root.confirmed(root.selected-type, root.chart-title); }
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        border-radius: 5px;
                        background: parent.has-hover ? #1a5c38 : #217346;
                        Text {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            text: @tr("确定");
                            font-size: 13px;
                            font-weight: 600;
                            color: white;
                        }
                    }
                }

                // 取消
                TouchArea {
                    width: 114px;
                    height: 32px;
                    clicked => { root.cancelled(); }
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: #c0c0c0;
                        background: parent.has-hover ? #ebebeb : white;
                        Text {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            text: @tr("取消");
                            font-size: 13px;
                            color: #333;
                        }
                    }
                }
            }
        }
    }
}
