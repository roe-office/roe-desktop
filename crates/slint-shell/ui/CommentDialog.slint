// CommentDialog.slint — Writer「新建批注」对话框（v284）
import { DialogShell } from "DialogShell.slint";

export component CommentDialog inherits Rectangle {
    in-out property <bool> visible-dialog: false;
    in-out property <string> comment-text: "";
    in property <string> dlg-title: @tr("新建批注");
    callback confirmed();
    callback cancelled();
    background: transparent;

    DialogShell {
        accent: #2b579a;
        accent-hover: #1e3f73;
        visible-dialog <=> root.visible-dialog;
        title: root.dlg-title;
        card-width: 360px;
        card-height: 250px;
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }

        Text { x: 16px; y: 52px; text: @tr("批注内容"); font-size: 12px; font-weight: 600; color: #1a1a1a; }
        Rectangle {
            x: 16px; y: 74px; width: 328px; height: 80px;
            border-radius: 4px;
            border-width: 1px;
            border-color: inp.has-focus ? #2b579a : #c0c0c0;
            background: #ffffff;
            inp := TextInput {
                x: 6px; y: 6px;
                width: parent.width - 12px;
                height: parent.height - 12px;
                font-size: 12px;
                color: #222222;
                wrap: word-wrap;
                text <=> root.comment-text;
            }
        }
    }
}
