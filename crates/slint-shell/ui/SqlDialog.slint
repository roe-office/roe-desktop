// SqlDialog.slint — 多数据集 SQL 查询:运行预览(不注册)→ 保存为新数据集
// 状态全在 Rust;运行只预览,保存才注册 df_N 并写预览 sheet。

import { ListView } from "std-widgets.slint";

export component SqlDialog inherits Rectangle {
    in-out property <bool> visible-dialog: false;
    in-out property <string> sql-text: "";
    in property <string> status-text: "";
    in property <[string]> ds-names: [];
    in property <[string]> res-cols: [];
    in property <[[string]]> res-rows: [];

    callback run-clicked(string);
    callback save-clicked(string);
    callback closed();

    background: transparent;
    visible: root.visible-dialog;

    property <length> card-w: 860px;
    property <length> card-h: 580px;
    property <length> res-col-w: root.res-cols.length > 0
        ? max(110px, (root.card-w - 32px) / root.res-cols.length)
        : 100px;
    property <length> res-view-w: max(root.card-w, root.res-cols.length * root.res-col-w + 32px);

    Rectangle {
        width: parent.width; height: parent.height;
        background: #00000040;
        TouchArea { width: parent.width; height: parent.height; scroll-event(e) => { accept } }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.card-w; height: root.card-h;
        background: #ffffff;
        border-radius: 8px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000030;
        clip: true;

        TouchArea { width: parent.width; height: parent.height; }

        // 标题栏
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: 40px;
            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #e8e8e8; }
            Text {
                x: 16px; y: (parent.height - self.height) / 2;
                text: @tr("SQL 查询(可 JOIN 多个数据集)"); font-size: 14px; font-weight: 600; color: #1a1a1a;
            }
            close-touch := TouchArea {
                x: parent.width - 32px; y: (parent.height - 24px) / 2;
                width: 24px; height: 24px;
                clicked => { root.closed(); }
                Rectangle {
                    background: close-touch.has-hover ? #f0f0f0 : transparent;
                    border-radius: 4px;
                    Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: "×"; font-size: 16px; color: #666666; }
                }
            }
        }

        // 数据集 chip(点击把表名追加到 SQL 末尾)
        Rectangle {
            x: 0px; y: 40px; width: parent.width; height: 24px; background: #fafafa;
            Text {
                x: 16px; y: (parent.height - self.height) / 2;
                text: @tr("数据集(点击追加表名)"); font-size: 12px; font-weight: 600; color: #666666;
            }
        }
        Rectangle {
            x: 0px; y: 64px; width: parent.width; height: 36px; clip: true;
            HorizontalLayout {
                x: 16px; y: 6px; width: parent.width - 32px; height: 24px;
                spacing: 6px; alignment: start;
                for n in root.ds-names: Rectangle {
                    height: 24px; width: chip-text.preferred-width + 16px;
                    border-radius: 3px; background: chip-touch.has-hover ? #217346 : #e8f5ee;
                    border-color: #217346; border-width: 1px;
                    chip-text := Text {
                        x: 8px; y: (parent.height - self.height) / 2;
                        text: n; font-size: 12px;
                        color: chip-touch.has-hover ? #ffffff : #217346;
                    }
                    chip-touch := TouchArea {
                        clicked => { root.sql-text = root.sql-text + (root.sql-text == "" ? "" : " ") + n; }
                    }
                }
            }
        }

        // SQL 输入框
        Rectangle {
            x: 16px; y: 104px; width: parent.width - 32px; height: 100px;
            border-radius: 4px; border-color: #c8c8c8; border-width: 1px; background: #ffffff;
            TextInput {
                x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 12px;
                text <=> root.sql-text;
                font-size: 13px; color: #1a1a1a; wrap: word-wrap;
            }
        }

        // 运行按钮 + 状态
        run-touch := TouchArea {
            x: 16px; y: 212px; width: 88px; height: 28px;
            clicked => { root.run-clicked(root.sql-text); }
            Rectangle {
                border-radius: 4px;
                background: run-touch.has-hover ? #1a5c38 : #217346;
                Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: @tr("▶ 运行预览"); font-size: 12px; color: #ffffff; }
            }
        }
        Text {
            x: 116px; y: 212px; width: parent.width - 132px; height: 28px;
            text: root.status-text; font-size: 12px; color: #555555;
            vertical-alignment: center; overflow: elide;
        }

        // 结果表头 + 结果行(横向滚动,表头与列表同步)
        Rectangle {
            x: 0px; y: 248px; width: parent.width; height: 28px;
            background: #f3f3f3;
            clip: true;
            Flickable {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                interactive: false;
                viewport-width: root.res-view-w;
                viewport-x <=> res-list.viewport-x;
                HorizontalLayout {
                    x: 16px; width: root.res-view-w - 32px;
                    alignment: start;
                    for c in root.res-cols: Text {
                        width: root.res-col-w;
                        text: c; overflow: elide;
                        font-size: 12px; font-weight: 600; color: #1a1a1a;
                        vertical-alignment: center;
                    }
                }
            }
        }
        res-list := ListView {
            x: 0px; y: 276px;
            width: parent.width; height: parent.height - 276px - 48px;
            viewport-width: root.res-view-w;
            for row in root.res-rows: Rectangle {
                height: 24px;
                HorizontalLayout {
                    x: 16px; width: root.res-view-w - 32px;
                    alignment: start;
                    for cell in row: Text {
                        width: root.res-col-w;
                        text: cell; overflow: elide;
                        font-size: 12px; color: #333333;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 底部栏
        Rectangle {
            x: 0px; y: parent.height - 48px; width: parent.width; height: 48px;
            background: #fafafa;
            Rectangle { y: 0px; width: parent.width; height: 1px; background: #e8e8e8; }
            Text {
                x: 16px; y: (parent.height - self.height) / 2;
                text: @tr("运行预览不改动文档;保存才会生成新数据集"); font-size: 12px; color: #666666;
            }
            cancel-touch := TouchArea {
                x: parent.width - 16px - 140px - 8px - 64px; y: (parent.height - 28px) / 2;
                width: 64px; height: 28px;
                clicked => { root.closed(); }
                Rectangle {
                    border-radius: 4px; border-color: #c0c0c0; border-width: 1px;
                    background: cancel-touch.has-hover ? #f0f0f0 : #ffffff;
                    Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: @tr("关闭"); font-size: 12px; color: #333333; }
                }
            }
            save-touch := TouchArea {
                x: parent.width - 16px - 140px; y: (parent.height - 28px) / 2;
                width: 140px; height: 28px;
                clicked => { root.save-clicked(root.sql-text); }
                Rectangle {
                    border-radius: 4px;
                    background: save-touch.has-hover ? #1a5c38 : #217346;
                    Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: @tr("保存为数据集并预览"); font-size: 12px; color: #ffffff; }
                }
            }
        }
    }
}
