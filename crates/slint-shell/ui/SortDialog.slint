// SortDialog.slint — Writer「排序」对话框（v274）
import { DialogShell } from "DialogShell.slint";

export component SortDialog inherits Rectangle {
    in-out property <bool> visible-dialog: false;
    in-out property <int> kind: 0;
    in-out property <bool> desc: false;
    callback confirmed();
    callback cancelled();
    background: transparent;

    DialogShell {
        accent: #2b579a;
        accent-hover: #1e3f73;
        visible-dialog <=> root.visible-dialog;
        title: @tr("排序");
        card-width: 320px;
        card-height: 230px;
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }

        Text { x: 16px; y: 52px; text: @tr("排序类型"); font-size: 12px; font-weight: 600; color: #1a1a1a; }
        for name[i] in [@tr("文字（拼音/字母）"), @tr("数字")]: Rectangle {
            x: 16px + i * 150px;
            y: 74px;
            width: 140px;
            height: 26px;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.kind == i ? #2b579a : #c0c0c0;
            background: root.kind == i ? #e8f0fc : #ffffff;
            Text { text: name; font-size: 12px; color: #222222; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.kind = i; } }
        }

        Text { x: 16px; y: 118px; text: @tr("排序方向"); font-size: 12px; font-weight: 600; color: #1a1a1a; }
        for name[i] in [@tr("升序"), @tr("降序")]: Rectangle {
            x: 16px + i * 150px;
            y: 140px;
            width: 140px;
            height: 26px;
            border-radius: 4px;
            border-width: 1px;
            border-color: (root.desc ? 1 : 0) == i ? #2b579a : #c0c0c0;
            background: (root.desc ? 1 : 0) == i ? #e8f0fc : #ffffff;
            Text { text: name; font-size: 12px; color: #222222; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.desc = (i == 1); } }
        }
    }
}
