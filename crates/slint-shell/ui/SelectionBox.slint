global Geo {
    // 局部点(lx,ly)（相对中心）旋转 rot 度后的世界坐标
    public pure function px(cx: float, cy: float, lx: float, ly: float, rot: float) -> float {
        return cx + lx * Math.cos(rot * 1deg) - ly * Math.sin(rot * 1deg);
    }
    public pure function py(cx: float, cy: float, lx: float, ly: float, rot: float) -> float {
        return cy + lx * Math.sin(rot * 1deg) + ly * Math.cos(rot * 1deg);
    }
    // 旋转矩形 -> Path commands
    public pure function quad(x: float, y: float, w: float, h: float, rot: float) -> string {
        let cx = x + w / 2;
        let cy = y + h / 2;
        let hw = w / 2;
        let hh = h / 2;
        let c = Math.cos(rot * 1deg);
        let s = Math.sin(rot * 1deg);
        let x1 = cx - hw * c + hh * s;
        let y1 = cy - hw * s - hh * c;
        let x2 = cx + hw * c + hh * s;
        let y2 = cy + hw * s - hh * c;
        let x3 = cx + hw * c - hh * s;
        let y3 = cy + hw * s + hh * c;
        let x4 = cx - hw * c - hh * s;
        let y4 = cy - hw * s + hh * c;
        return "M " + x1 + " " + y1 + " L " + x2 + " " + y2 + " L " + x3 + " " + y3 + " L " + x4 + " " + y4 + " Z";
    }
    public pure function seg(x1: float, y1: float, x2: float, y2: float) -> string {
        return "M " + x1 + " " + y1 + " L " + x2 + " " + y2;
    }
}

component HDot inherits Rectangle {
    in property <length> cx;
    in property <length> cy;
    in property <length> sz: 8px;
    in property <bool> hot: false;
    x: root.cx - root.sz / 2;
    y: root.cy - root.sz / 2;
    width: root.sz;
    height: root.sz;
    background: root.hot ? #f9e2af : white;
    border-width: 1px;
    border-color: #7f6a2d;
}

// 通用选择框：必须放在画布左上角并铺满画布。坐标全部是画布逻辑 px。
export component SelectionBox inherits Rectangle {
    in property <bool> active: false;
    in property <float> obj-x;
    in property <float> obj-y;
    in property <float> obj-w;
    in property <float> obj-h;
    in property <float> obj-rot;
    in property <bool> rotatable: true;
    out property <string> hover-mode: (ta.has-hover && root.active) ? root.hit-mode(ta.mouse-x / 1px, ta.mouse-y / 1px) : "";
    property <string> active-mode: "";
    property <float> ocx: root.obj-x + root.obj-w / 2;
    property <float> ocy: root.obj-y + root.obj-h / 2;
    // 小对象自适应：命中半径随对象缩小，中间句柄在边不够长时隐藏
    property <float> hr: Math.min(7.0, Math.max(3.0, Math.min(root.obj-w, root.obj-h) / 2.5));
    property <length> hsz: Math.max(4px, root.hr * 1px * 1.2);
    property <bool> show-ns: root.obj-w >= 40;
    property <bool> show-we: root.obj-h >= 40;

    callback drag-started(string, float, float);
    callback drag-moved(float, float, bool, bool);
    callback drag-ended();
    callback miss-clicked(float, float);
    callback right-clicked(float, float, bool);
    callback double-clicked(float, float);

    pure function hx(fx: float, fy: float) -> length {
        return Geo.px(root.ocx, root.ocy, fx * root.obj-w / 2, fy * root.obj-h / 2, root.obj-rot) * 1px;
    }
    pure function hy(fx: float, fy: float) -> length {
        return Geo.py(root.ocx, root.ocy, fx * root.obj-w / 2, fy * root.obj-h / 2, root.obj-rot) * 1px;
    }

    pure function hit-mode(px: float, py: float) -> string {
        if (!root.active) { return ""; }
        let c = Math.cos(root.obj-rot * 1deg);
        let s = Math.sin(root.obj-rot * 1deg);
        let lx = (px - root.ocx) * c + (py - root.ocy) * s;
        let ly = (py - root.ocy) * c - (px - root.ocx) * s;
        let hw = root.obj-w / 2;
        let hh = root.obj-h / 2;
        let r = root.hr;
        if (root.rotatable && abs(lx) < r && abs(ly + hh + 24) < r) { return "rotate"; }
        if (abs(lx + hw) < r && abs(ly + hh) < r) { return "nw"; }
        if (abs(lx - hw) < r && abs(ly + hh) < r) { return "ne"; }
        if (abs(lx + hw) < r && abs(ly - hh) < r) { return "sw"; }
        if (abs(lx - hw) < r && abs(ly - hh) < r) { return "se"; }
        if (root.show-ns && abs(lx) < r && abs(ly + hh) < r) { return "n"; }
        if (root.show-ns && abs(lx) < r && abs(ly - hh) < r) { return "s"; }
        if (root.show-we && abs(lx + hw) < r && abs(ly) < r) { return "w"; }
        if (root.show-we && abs(lx - hw) < r && abs(ly) < r) { return "e"; }
        if (abs(lx) <= hw && abs(ly) <= hh) { return "move"; }
        return "";
    }

    // 光标方向 = 句柄方向 + 对象旋转角，按 45° 量化
    pure function cursor-for(mode: string) -> MouseCursor {
        if (mode == "") { return MouseCursor.default; }
        if (mode == "move") { return MouseCursor.move; }
        if (mode == "rotate") { return MouseCursor.grab; }
        let base = mode == "e" ? 0.0 : mode == "se" ? 45.0 : mode == "s" ? 90.0 : mode == "sw" ? 135.0
            : mode == "w" ? 180.0 : mode == "nw" ? 225.0 : mode == "n" ? 270.0 : 315.0;
        let q = Math.round(Math.mod(base + root.obj-rot + 720.0, 180.0) / 45.0);
        if (q == 1) { return MouseCursor.nwse-resize; }
        if (q == 2) { return MouseCursor.ns-resize; }
        if (q == 3) { return MouseCursor.nesw-resize; }
        return MouseCursor.ew-resize;
    }

    // ── 绘制部分：只画，不接收事件 ──
    if root.active : Path {
        x: 0px; y: 0px; width: root.width; height: root.height;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: Geo.quad(root.obj-x, root.obj-y, root.obj-w, root.obj-h, root.obj-rot);
        stroke: #f9e2af;
        stroke-width: 1px;
    }
    if root.active && root.rotatable : Path {
        x: 0px; y: 0px; width: root.width; height: root.height;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: Geo.seg(
            Geo.px(root.ocx, root.ocy, 0, -root.obj-h / 2, root.obj-rot),
            Geo.py(root.ocx, root.ocy, 0, -root.obj-h / 2, root.obj-rot),
            Geo.px(root.ocx, root.ocy, 0, -root.obj-h / 2 - 24, root.obj-rot),
            Geo.py(root.ocx, root.ocy, 0, -root.obj-h / 2 - 24, root.obj-rot));
        stroke: #f9e2af;
        stroke-width: 1px;
    }
    if root.active && root.rotatable : Rectangle {
        x: root.hx(0, -1 - 48 / root.obj-h) - root.hsz / 2;
        y: root.hy(0, -1 - 48 / root.obj-h) - root.hsz / 2;
        width: root.hsz; height: root.hsz; border-radius: root.hsz / 2;
        background: root.hover-mode == "rotate" ? #f9e2af : #a6e3a1;
        border-width: 1px; border-color: #3b6b3b;
    }
    if root.active : HDot { cx: root.hx(-1, -1); cy: root.hy(-1, -1); sz: root.hsz; hot: root.hover-mode == "nw"; }
    if root.active : HDot { cx: root.hx(1, -1);  cy: root.hy(1, -1);  sz: root.hsz; hot: root.hover-mode == "ne"; }
    if root.active : HDot { cx: root.hx(-1, 1);  cy: root.hy(-1, 1);  sz: root.hsz; hot: root.hover-mode == "sw"; }
    if root.active : HDot { cx: root.hx(1, 1);   cy: root.hy(1, 1);   sz: root.hsz; hot: root.hover-mode == "se"; }
    if root.active && root.show-ns : HDot { cx: root.hx(0, -1); cy: root.hy(0, -1); sz: root.hsz; hot: root.hover-mode == "n"; }
    if root.active && root.show-ns : HDot { cx: root.hx(0, 1);  cy: root.hy(0, 1);  sz: root.hsz; hot: root.hover-mode == "s"; }
    if root.active && root.show-we : HDot { cx: root.hx(-1, 0); cy: root.hy(-1, 0); sz: root.hsz; hot: root.hover-mode == "w"; }
    if root.active && root.show-we : HDot { cx: root.hx(1, 0);  cy: root.hy(1, 0);  sz: root.hsz; hot: root.hover-mode == "e"; }

    // ── 整个画布唯一的事件接收者：命中判断都在这里做 ──
    ta := TouchArea {
        property <bool> shift: false;
        property <bool> ctrl: false;
        mouse-cursor: root.cursor-for(self.pressed ? root.active-mode : root.hover-mode);
        pointer-event(e) => {
            self.shift = e.modifiers.shift;
            self.ctrl = e.modifiers.control;
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.right-clicked(self.mouse-x / 1px, self.mouse-y / 1px, root.hit-mode(self.mouse-x / 1px, self.mouse-y / 1px) != "");
            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                let m = root.hit-mode(self.mouse-x / 1px, self.mouse-y / 1px);
                if (m == "") {
                    root.miss-clicked(self.mouse-x / 1px, self.mouse-y / 1px);
                } else {
                    root.drag-started(m, self.mouse-x / 1px, self.mouse-y / 1px);
                    root.active-mode = m;
                }
            } else if (root.active-mode != "" && (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel)) {
                root.active-mode = "";
                root.drag-ended();
            }
        }
        double-clicked => {
            if (root.hit-mode(self.mouse-x / 1px, self.mouse-y / 1px) != "") {
                root.double-clicked(self.mouse-x / 1px, self.mouse-y / 1px);
            }
        }
        moved => {
            if (root.active-mode != "") {
                root.drag-moved(self.mouse-x / 1px, self.mouse-y / 1px, self.shift, self.ctrl);
            }
        }
    }
}
