// PivotFieldsDialog.slint — 创建透视表第二步：选择字段（行/列/值/筛选）
// 外壳改用 DialogShell 通用组件(2026-09-23，DialogShell抽取)，内嵌 PivotSidebar 字段拖拽面板

import { PivotSidebar } from "PivotSidebar.slint";
import { DialogShell } from "DialogShell.slint";

export component PivotFieldsDialog inherits Rectangle {
    in-out property <bool> visible-dialog: false;
    in property <[string]> available-fields: [];
    in-out property <[string]> row-fields: [];
    in-out property <[string]> col-fields: [];
    in-out property <[string]> value-fields: [];
    in-out property <[string]> filter-fields: [];

    callback add-field-to-zone(string, string);
    callback menu-add-field-to-zone(string, string);
    callback remove-field(string);
    callback confirmed();
    callback cancelled();

    background: transparent;

    DialogShell {
        visible-dialog <=> root.visible-dialog;
        title: @tr("选择透视表字段");
        card-width: 520px;
        card-height: 460px;
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }

        // 字段面板主体
        PivotSidebar {
            x: 0px; y: 40px;
            width: parent.width;
            height: parent.height - 40px - 48px;
            fields: root.available-fields;
            row-fields: root.row-fields;
            col-fields: root.col-fields;
            value-fields: root.value-fields;
            filter-fields: root.filter-fields;
            add-field-to-zone(name, zone) => { root.add-field-to-zone(name, zone); }
            menu-add-field-to-zone(name, zone) => { root.menu-add-field-to-zone(name, zone); }
            remove-field(name) => { root.remove-field(name); }
        }
    }
}
