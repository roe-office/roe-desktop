// ImpressPlaceholderDialog.slint — Impress 母版视图「插入占位符」对话框（v320n）
import { DialogShell } from "DialogShell.slint";

export component ImpressPlaceholderDialog inherits Rectangle {
    in-out property <bool> visible-dialog: false;
    in property <bool> has-title: false;
    in property <bool> has-body: false;
    in property <bool> has-date: false;
    in property <bool> has-footer: false;
    in property <bool> has-num: false;
    in-out property <string> kind: "";
    callback confirmed();
    callback cancelled();
    background: transparent;

    changed visible-dialog => {
        if (root.visible-dialog) { root.kind = ""; }
    }

    DialogShell {
        accent: #c43e1c;
        accent-hover: #9e2f14;
        visible-dialog <=> root.visible-dialog;
        title: @tr("插入占位符");
        card-width: 320px;
        card-height: 286px;
        confirm-enabled: root.kind != "";
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }

        for item[i] in [
            { key: "title", label: @tr("标题"), exists: root.has-title },
            { key: "body", label: @tr("正文"), exists: root.has-body },
            { key: "date", label: @tr("日期"), exists: root.has-date },
            { key: "footer", label: @tr("页脚"), exists: root.has-footer },
            { key: "slide_number", label: @tr("页码"), exists: root.has-num },
        ] : Rectangle {
            x: 16px;
            y: 52px + i * 36px;
            width: 288px;
            height: 30px;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.kind == item.key ? #c43e1c : #d0d0d0;
            background: item.exists ? #f2f2f2 : (root.kind == item.key ? #fdeee9 : #ffffff);
            Text {
                x: 10px;
                text: item.exists ? @tr("{}（已存在）", item.label) : item.label;
                font-size: 12px;
                color: item.exists ? #999999 : #222222;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { if (!item.exists) { root.kind = item.key; } }
            }
        }
    }
}
