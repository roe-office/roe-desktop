// FormulaBar.slint — Calc 公式栏
// 包含：名称框 / fx标签 / 公式输入框

export component FormulaBar inherits Rectangle {
    in property <string> calc-address: "A1";
    in property <string> calc-display-value: "";
    // 公式函数自动补全（简化版，2026-07-10）：仅基于roe_get_formula_function_list
    // 返回的34个常用函数做前缀匹配，只看输入框末尾连续字母，不感知光标中间插入
    // 位置（见ROE需求文档，完整版需要ROE补token/span接口）。
    in property <[string]> suggestion-list: [];
    callback suggestion-picked(string);

    callback formula-edited(string);
    callback formula-committed(string);
    callback formula-cancelled();

    // 每次 calc-display-value 变化强制刷新
    // 注意：用 "\ " + real value 技巧绕过 Slint changed 不触发同值问题
    // 实际做法：在 Rust 端每次先 set ""，再 set 真实值
    changed calc-display-value => {
        formula-input.text = root.calc-display-value;
    }

    height: 28px;
    background: #f9f9f9;
    border-width: 0px;

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: #e1e1e1;
    }

    HorizontalLayout {
        spacing: 0px;
        padding: 0px;

        Rectangle {
            width: 80px;
            background: #f9f9f9;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: #e1e1e1;
            }
            Text {
                text: root.calc-address;
                color: #222222;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        Rectangle {
            width: 28px;
            background: #f9f9f9;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: #e1e1e1;
            }
            Text {
                text: "fx";
                color: #489189;
                font-size: 12px;
                font-italic: true;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: #ffffff;
            formula-input := TextInput {
                x: 8px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 16px;
                height: 18px;
                text: "";
                color: #222222;
                font-size: 12px;
                edited => {
                    root.formula-edited(self.text);
                }
                accepted => {
                    root.formula-committed(self.text);
                    formula-input.clear-focus();
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        formula-input.text = root.calc-display-value;
                        formula-input.clear-focus();
                        root.formula-cancelled();
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }
}
