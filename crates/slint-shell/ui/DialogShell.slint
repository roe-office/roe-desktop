// DialogShell.slint — 居中模态对话框通用外壳
// 从 ColumnPickDialog/TextSplitDialog/PivotFieldsDialog/PivotSourceDialog 四个
// 对话框中抽取出的公共部分：遮罩层 + 居中卡片 + 标题栏(标题+×关闭) + 内容区(@children) + 底部按钮栏(取消/确定)。
// 内容区通过 @children 插入，调用方保留各自的业务内容子元素，尺寸通过 card-width/card-height 指定。
// confirmed/cancelled 均为无参回调；若原对话框的 confirmed 需要携带参数，
// 改为调用方在 confirmed 触发时从 root 的 in-out property 里自行读取当前状态
// （参见 PivotSourceDialog 改造：range-text/new-sheet-selected/location-text 已是
// in-out property，app.slint 转发处直接读这三个属性再喂给顶层回调，Rust 端签名不变）。
// 不适用范围：FilterDialog（锚定弹出，非居中模态，无标题栏/遮罩）、
// InsertChartDialog（独立视觉体系，尺寸/配色均不同）、
// ChartColorPickerDialog（非模态浮层，无遮罩无居中定位）——这三者不要套用此组件。

export component DialogShell inherits Rectangle {
    in-out property <bool> visible-dialog: false;
    in property <string> title: "";
    in property <length> card-width: 360px;
    in property <length> card-height: 300px;
    in property <bool> confirm-enabled: true;
    in property <color> accent: #217346;
    in property <color> accent-hover: #1a5c38;

    callback confirmed();
    callback cancelled();

    background: transparent;
    visible: root.visible-dialog;

    // 遮罩层
    Rectangle {
        x: 0px; y: 0px;
        width: parent.width;
        height: parent.height;
        background: #00000040;
        TouchArea {
            width: parent.width; height: parent.height;
            clicked => { root.cancelled(); }
            scroll-event(e) => { accept }
        }
    }

    // 居中卡片
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.card-width;
        height: root.card-height;
        background: #ffffff;
        border-radius: 8px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000030;

        // 吞掉卡片内的点击，避免落到遮罩触发取消
        TouchArea { width: parent.width; height: parent.height; scroll-event(e) => { accept } }

        // 标题栏
        Rectangle {
            x: 0px; y: 0px;
            width: parent.width; height: 40px;
            background: #ffffff;
            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #e8e8e8; }
            Text {
                x: 16px;
                y: (parent.height - self.height) / 2;
                text: root.title;
                font-size: 14px; font-weight: 600; color: #1a1a1a;
            }
            close-touch := TouchArea {
                x: parent.width - 32px; y: (parent.height - 24px) / 2;
                width: 24px; height: 24px;
                clicked => { root.cancelled(); }
                Rectangle {
                    background: close-touch.has-hover ? #f0f0f0 : transparent;
                    border-radius: 4px;
                    Text { x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; text: "×"; font-size: 16px; color: #666666; }
                }
            }
        }

        // 内容区：调用方子元素插入此处，自行控制内部坐标(相对卡片原点，
        // 需自己避让顶部40px标题栏和底部48px按钮栏)
        @children

        // 底部按钮栏
        Rectangle {
            x: 0px; y: parent.height - 48px;
            width: parent.width; height: 48px;
            background: #fafafa;
            Rectangle { y: 0px; width: parent.width; height: 1px; background: #e8e8e8; }
            HorizontalLayout {
                x: parent.width - 16px - 160px;
                y: (parent.height - 28px) / 2;
                width: 160px; height: 28px;
                spacing: 8px;
                alignment: end;
                cancel-touch := TouchArea {
                    width: 64px; height: 28px;
                    clicked => { root.cancelled(); }
                    Rectangle {
                        border-radius: 4px;
                        border-color: #c0c0c0; border-width: 1px;
                        background: cancel-touch.has-hover ? #f0f0f0 : #ffffff;
                        Text { x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; text: @tr("取消"); font-size: 12px; color: #333333; }
                    }
                }
                confirm-touch := TouchArea {
                    width: 80px; height: 28px;
                    enabled: root.confirm-enabled;
                    clicked => { root.confirmed(); }
                    Rectangle {
                        border-radius: 4px;
                        background: !root.confirm-enabled ? #a8c9b6 : (confirm-touch.has-hover ? root.accent-hover : root.accent);
                        Text { x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; text: @tr("确定"); font-size: 12px; color: #ffffff; }
                    }
                }
            }
        }
    }
}
