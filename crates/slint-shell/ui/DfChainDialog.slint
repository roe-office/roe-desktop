// DfChainDialog.slint — DF 链式查询:运行预览(不注册)→ 保存为 chain_N
// 代码一行一条语句;状态全在 Rust。

import { ScrollView, TextEdit } from "std-widgets.slint";

// 小下拉按钮:只显示当前值,点击上报;弹出列表由对话框末尾的浮层绘制
component DfDrop inherits Rectangle {
    in property <[string]> labels: [];
    in property <int> index: 0;
    callback open-me();

    height: 20px;
    border-radius: 3px; border-color: #c8c8c8; border-width: 1px;
    background: drop-touch.has-hover ? #e8e8e8 : #f3f3f3;
    Text { x: 6px; y: (parent.height - self.height) / 2; text: root.labels[root.index]; font-size: 12px; color: #333333; }
    Text { x: parent.width - 14px; y: (parent.height - self.height) / 2; text: "▾"; font-size: 10px; color: #666666; }
    drop-touch := TouchArea { clicked => { root.open-me(); } }
}

export component DfChainDialog inherits Rectangle {
    in-out property <bool> visible-dialog: false;
    in-out property <string> code-text: "";
    in property <string> status-text: "";
    in property <[string]> ds-names: [];
    in property <[string]> col-names: [];
    in property <[bool]> col-on: [];
    in-out property <int> p-rows: 0;
    property <int> open-drop: -1;
    property <[string]> pop-labels: root.open-drop == 0 ? root.row-labels : (root.open-drop == 1 ? root.sort-labels : root.agg-labels);
    in-out property <bool> p-desc: true;
    property <[string]> row-labels: [@tr("全部"), @tr("前10"), @tr("前20"), @tr("前50")];
    property <[string]> row-vals: ["", "10", "20", "50"];
    property <[string]> sort-labels: [@tr("降序"), @tr("升序")];
    property <[string]> agg-labels: [@tr("求和"), @tr("平均值"), @tr("最小值"), @tr("最大值"), @tr("计数"), @tr("第一个"), @tr("最后一个"), @tr("标准差"), @tr("方差")];
    in-out property <int> p-agg: 0;
    property <[string]> agg-names: ["sum", "mean", "min", "max", "count", "first", "last", "std", "var"];
    in property <[string]> res-cols: [];
    in property <[[string]]> res-rows: [];

    callback run-clicked(string);
    callback save-clicked(string);
    callback ds-picked(string);
    callback col-toggled(int);
    callback build-line(string, string, bool, string) -> string;
    callback closed();

    background: transparent;
    visible: root.visible-dialog;

    property <length> card-w: 860px;
    property <length> card-h: 620px;
    property <length> res-col-w: root.res-cols.length > 0
        ? max(110px, (root.card-w - 32px) / root.res-cols.length)
        : 110px;
    property <length> res-view-w: max(root.card-w, root.res-cols.length * root.res-col-w + 32px);
    property <[string]> tpl-labels: [@tr("取前N行"), @tr("选列"), @tr("删列"), @tr("排序"), @tr("去重"), @tr("删空值"), @tr("重命名"), @tr("分组聚合"), @tr("派生列")];
    property <[string]> tpl-kinds: ["head", "select", "drop", "sort", "dedup", "dropnulls", "rename", "groupby", "withcol"];

    Rectangle {
        width: parent.width; height: parent.height;
        background: #00000040;
        TouchArea { width: parent.width; height: parent.height; scroll-event(e) => { accept } }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.card-w; height: root.card-h;
        background: #ffffff;
        border-radius: 8px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000030;
        clip: true;

        TouchArea { width: parent.width; height: parent.height; }

        // 标题栏
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: 40px;
            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #e8e8e8; }
            Text {
                x: 16px; y: (parent.height - self.height) / 2;
                text: @tr("DF 链式查询(一行一条语句,以 df_use 开头)"); font-size: 14px; font-weight: 600; color: #1a1a1a;
            }
            close-touch := TouchArea {
                x: parent.width - 32px; y: (parent.height - 24px) / 2;
                width: 24px; height: 24px;
                clicked => { root.closed(); }
                Rectangle {
                    background: close-touch.has-hover ? #f0f0f0 : transparent;
                    border-radius: 4px;
                    Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: "×"; font-size: 16px; color: #666666; }
                }
            }
        }

        // 数据集 chip:点击 = 追加 df_use("名") 并刷新列名 chip
        Rectangle {
            x: 0px; y: 40px; width: parent.width; height: 24px; background: #fafafa;
            Text { x: 16px; y: (parent.height - self.height) / 2; text: @tr("数据集(点击载入)"); font-size: 12px; font-weight: 600; color: #666666; }
        }
        Rectangle {
            x: 0px; y: 64px; width: parent.width; height: 32px; clip: true;
            HorizontalLayout {
                x: 16px; y: 4px; width: parent.width - 32px; height: 24px;
                spacing: 6px; alignment: start;
                for n in root.ds-names: Rectangle {
                    height: 24px; width: ds-text.preferred-width + 16px;
                    border-radius: 3px; background: ds-touch.has-hover ? #217346 : #e8f5ee;
                    border-color: #217346; border-width: 1px;
                    ds-text := Text { x: 8px; y: (parent.height - self.height) / 2; text: n; font-size: 12px; color: ds-touch.has-hover ? #ffffff : #217346; }
                    ds-touch := TouchArea {
                        clicked => {
                            root.code-text = root.code-text + (root.code-text == "" ? "" : "\n") + "df_use(\"" + n + "\");";
                            root.ds-picked(n);
                        }
                    }
                }
            }
        }

        // 列名 chip:点击 = 追加 "列名"
        Rectangle {
            x: 0px; y: 96px; width: parent.width; height: 24px; background: #fafafa;
            Text { x: 16px; y: (parent.height - self.height) / 2; text: @tr("列名(点击选中/取消;最后选中的列在「分组聚合」中作为被聚合列)"); font-size: 12px; font-weight: 600; color: #666666; }
        }
        Rectangle {
            x: 0px; y: 120px; width: parent.width; height: 32px; clip: true;
            HorizontalLayout {
                x: 16px; y: 4px; width: parent.width - 32px; height: 24px;
                spacing: 6px; alignment: start;
                for c[ci] in root.col-names: Rectangle {
                    height: 24px; width: col-text.preferred-width + 16px;
                    border-radius: 3px; background: (col-touch.has-hover || root.col-on[ci]) ? #1f5fbf : #e8f0fc;
                    border-color: #1f5fbf; border-width: 1px;
                    col-text := Text { x: 8px; y: (parent.height - self.height) / 2; text: c; font-size: 12px; color: (col-touch.has-hover || root.col-on[ci]) ? #ffffff : #1f5fbf; }
                    col-touch := TouchArea {
                        clicked => { root.col-toggled(ci); }
                    }
                }
            }
        }

        // 函数模板:点击 = 追加一整行
        Rectangle {
            x: 0px; y: 152px; width: parent.width; height: 24px; background: #fafafa;
            Text { x: 16px; y: (parent.height - self.height) / 2; text: @tr("函数模板(用已选列生成一行)"); font-size: 12px; font-weight: 600; color: #666666; }
            Text { x: 240px; y: (parent.height - self.height) / 2; text: @tr("输出行数"); font-size: 12px; color: #666666; }
            DfDrop { x: 300px; y: 2px; width: 72px; labels: root.row-labels; index: root.p-rows; open-me => { root.open-drop = 0; } }
            Text { x: 392px; y: (parent.height - self.height) / 2; text: @tr("排序"); font-size: 12px; color: #666666; }
            DfDrop { x: 428px; y: 2px; width: 64px; labels: root.sort-labels; index: root.p-desc ? 0 : 1; open-me => { root.open-drop = 1; } }
            Text { x: 512px; y: (parent.height - self.height) / 2; text: @tr("聚合"); font-size: 12px; color: #666666; }
            DfDrop { x: 548px; y: 2px; width: 92px; labels: root.agg-labels; index: root.p-agg; open-me => { root.open-drop = 2; } }
        }
        Rectangle {
            x: 0px; y: 176px; width: parent.width; height: 36px; clip: true;
            HorizontalLayout {
                x: 16px; y: 6px; width: parent.width - 32px; height: 24px;
                spacing: 6px; alignment: start;
                for lbl[i] in root.tpl-labels: Rectangle {
                    height: 24px; width: tpl-text.preferred-width + 16px;
                    border-radius: 3px; background: tpl-touch.has-hover ? #e8e8e8 : #f3f3f3;
                    border-color: #c8c8c8; border-width: 1px;
                    tpl-text := Text { x: 8px; y: (parent.height - self.height) / 2; text: lbl; font-size: 12px; color: #333333; }
                    tpl-touch := TouchArea {
                        clicked => {
                            let l = root.build-line(root.tpl-kinds[i], root.row-vals[root.p-rows], root.p-desc, root.agg-names[root.p-agg]);
                            if (l != "") { root.code-text = root.code-text + (root.code-text == "" ? "" : "\n") + l; }
                        }
                    }
                }
            }
        }

        // 代码框
        TextEdit {
            x: 16px; y: 216px; width: parent.width - 32px; height: 120px;
            text <=> root.code-text;
            font-size: 13px;
            wrap: no-wrap;
        }

        // 运行 + 状态
        run-touch := TouchArea {
            x: 16px; y: 344px; width: 88px; height: 28px;
            clicked => { root.run-clicked(root.code-text); }
            Rectangle {
                border-radius: 4px;
                background: run-touch.has-hover ? #1a5c38 : #217346;
                Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: @tr("▶ 运行预览"); font-size: 12px; color: #ffffff; }
            }
        }
        clear-touch := TouchArea {
            x: 116px; y: 344px; width: 88px; height: 28px;
            clicked => { root.code-text = ""; }
            Rectangle {
                border-radius: 4px; border-color: #c0c0c0; border-width: 1px;
                background: clear-touch.has-hover ? #f0f0f0 : #ffffff;
                Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: @tr("清空代码"); font-size: 12px; color: #333333; }
            }
        }
        Text {
            x: 216px; y: 344px; width: parent.width - 232px; height: 28px;
            text: root.status-text; font-size: 12px; color: #555555;
            vertical-alignment: center; overflow: elide;
        }

        // 结果表:ScrollView(横竖滚动条),表头为第一行
        ScrollView {
            x: 0px; y: 380px;
            width: parent.width; height: parent.height - 380px - 48px;
            viewport-width: root.res-view-w;
            viewport-height: 28px + root.res-rows.length * 24px;
            Rectangle {
                x: 0px; y: 0px; width: root.res-view-w; height: 28px; background: #f3f3f3;
                for c[i] in root.res-cols: Text {
                    x: 16px + i * root.res-col-w; y: 0px;
                    width: root.res-col-w; height: 28px;
                    text: c; overflow: elide;
                    font-size: 12px; font-weight: 600; color: #1a1a1a;
                    vertical-alignment: center;
                }
            }
            for row[r] in root.res-rows: Rectangle {
                x: 0px; y: 28px + r * 24px; width: root.res-view-w; height: 24px;
                for cell[i] in row: Text {
                    x: 16px + i * root.res-col-w; y: 0px;
                    width: root.res-col-w; height: 24px;
                    text: cell; overflow: elide;
                    font-size: 12px; color: #333333;
                    vertical-alignment: center;
                }
            }
        }

        // 下拉浮层:遮罩(点外面关闭)+ 列表,位置对齐标题行里的三个下拉框(y=152+2+20)
        if root.open-drop >= 0: TouchArea {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            clicked => { root.open-drop = -1; }
        }
        if root.open-drop >= 0: Rectangle {
            x: root.open-drop == 0 ? 300px : (root.open-drop == 1 ? 428px : 548px);
            y: 176px;
            width: root.open-drop == 0 ? 72px : (root.open-drop == 1 ? 64px : 92px);
            height: pop-list.preferred-height + 8px;
            background: white; border-color: #c8c8c8; border-width: 1px; border-radius: 3px;
            drop-shadow-blur: 8px; drop-shadow-color: #00000030;
            pop-list := VerticalLayout {
                x: 0px; y: 4px; width: parent.width; padding: 0px; spacing: 2px;
                for l[i] in root.pop-labels: Rectangle {
                    height: 26px; border-radius: 3px;
                    background: pop-item.has-hover ? #e8f0fc : transparent;
                    Text { text: l; font-size: 12px; color: #222222; x: 8px; y: (parent.height - self.height) / 2; }
                    pop-item := TouchArea {
                        clicked => {
                            if (root.open-drop == 0) { root.p-rows = i; }
                            else if (root.open-drop == 1) { root.p-desc = (i == 0); }
                            else { root.p-agg = i; }
                            root.open-drop = -1;
                        }
                    }
                }
            }
        }

        // 底部栏
        Rectangle {
            x: 0px; y: parent.height - 48px; width: parent.width; height: 48px;
            background: #fafafa;
            Rectangle { y: 0px; width: parent.width; height: 1px; background: #e8e8e8; }
            Text {
                x: 16px; y: (parent.height - self.height) / 2;
                text: @tr("运行预览不改动文档;保存才会生成 chain_N"); font-size: 12px; color: #666666;
            }
            cancel-touch := TouchArea {
                x: parent.width - 16px - 140px - 8px - 64px; y: (parent.height - 28px) / 2;
                width: 64px; height: 28px;
                clicked => { root.closed(); }
                Rectangle {
                    border-radius: 4px; border-color: #c0c0c0; border-width: 1px;
                    background: cancel-touch.has-hover ? #f0f0f0 : #ffffff;
                    Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: @tr("关闭"); font-size: 12px; color: #333333; }
                }
            }
            save-touch := TouchArea {
                x: parent.width - 16px - 140px; y: (parent.height - 28px) / 2;
                width: 140px; height: 28px;
                clicked => { root.save-clicked(root.code-text); }
                Rectangle {
                    border-radius: 4px;
                    background: save-touch.has-hover ? #1a5c38 : #217346;
                    Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: @tr("保存为数据集并预览"); font-size: 12px; color: #ffffff; }
                }
            }
        }
    }
}
