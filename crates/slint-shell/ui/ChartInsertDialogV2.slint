// ChartInsertDialogV2.slint — 插入图表对话框（v221，宿主无关）
// 布局参照 Office/WPS：左侧分类，右上子类型缩略图，下方子类型名 + 大预览，底部 插入/取消。
// 本组件不含业务逻辑：数据全部由宿主通过 in 属性喂入，操作通过回调抛出。

import { ChartThumb } from "ChartThumbs.slint";

export component ChartInsertDialogV2 inherits Rectangle {
    in property <bool> open: false;
    in property <[string]> cats: [];
    in property <int> cat: 0;
    in property <[string]> type-names: [];
    in property <[string]> type-ids: [];
    in property <int> type-idx: 0;
    in property <string> type-title: "";
    in property <image> preview;
    in property <color> accent: #c43e1c;   // 主题色，由宿主按软件传入

    callback cat-picked(int);
    callback type-picked(int);
    callback confirmed();
    callback cancelled();

    background: transparent;
    visible: root.open;

    // 遮罩
    Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: #00000050;
        TouchArea {
            width: parent.width; height: parent.height;
            clicked => { root.cancelled(); }
            scroll-event(e) => { accept }
        }
    }

    // 卡片
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Math.min(900px, parent.width - 40px);
        height: Math.min(660px, parent.height - 40px);
        background: #f3f3f3;
        border-radius: 8px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;

        // 吞掉卡片内点击，避免落到遮罩
        TouchArea { width: parent.width; height: parent.height; scroll-event(e) => { accept } }

        Text {
            x: 16px; y: 12px;
            text: @tr("插入图表");
            font-size: 14px;
            font-weight: 700;
            color: #202020;
        }
        Rectangle {
            x: parent.width - 40px; y: 6px;
            width: 32px; height: 28px;
            background: xta.has-hover ? #e0e0e0 : transparent;
            Text { text: "×"; font-size: 18px; color: #404040; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
            xta := TouchArea { clicked => { root.cancelled(); } }
        }

        // 左侧分类
        Rectangle {
            x: 12px; y: 44px;
            width: 200px;
            height: parent.height - 44px - 64px;
            background: #ffffff;
            border-width: 1px;
            border-color: #d8d8d8;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                alignment: start;
                for c[i] in root.cats : Rectangle {
                    height: 32px;
                    background: i == root.cat ? #dcdcdc : (cta.has-hover ? #efefef : transparent);
                    Text {
                        x: 12px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: c;
                        font-size: 13px;
                        color: #202020;
                        vertical-alignment: center;
                    }
                    cta := TouchArea { clicked => { root.cat-picked(i); } }
                }
            }
        }

        // 右侧
        Rectangle {
            x: 224px; y: 44px;
            width: parent.width - 236px;
            height: parent.height - 44px - 64px;
            background: #ffffff;
            border-width: 1px;
            border-color: #d8d8d8;

            // 子类型缩略图行
            HorizontalLayout {
                x: 12px; y: 12px;
                height: 100px;
                spacing: 10px;
                alignment: start;
                for n[i] in root.type-names : Rectangle {
                    width: 120px;
                    height: 100px;
                    background: i == root.type-idx ? #e1e1e1 : (tta.has-hover ? #f0f0f0 : transparent);
                    ChartThumb {
                        x: 10px; y: 8px;
                        width: parent.width - 20px;
                        height: parent.height - 16px;
                        kind: root.type-ids[i];
                        stroke-color: root.accent;
                    }
                    tta := TouchArea { clicked => { root.type-picked(i); } }
                }
            }
            Rectangle { x: 12px; y: 122px; width: parent.width - 24px; height: 1px; background: #d0d0d0; }

            Text {
                x: 16px; y: 132px;
                text: root.type-title;
                font-size: 20px;
                font-weight: 700;
                color: #202020;
            }
            Rectangle {
                x: 16px; y: 172px;
                width: parent.width - 32px;
                height: parent.height - 188px;
                background: #ffffff;
                border-width: 1px;
                border-color: #d0d0d0;
                Image {
                    x: 4px; y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    source: root.preview;
                    image-fit: contain;
                }
            }
        }

        // 底部按钮
        Rectangle {
            x: parent.width - 12px - 96px; y: parent.height - 50px;
            width: 96px; height: 34px;
            background: #ffffff;
            border-width: 1px;
            border-color: #b0b0b0;
            border-radius: 3px;
            Text { text: @tr("取消"); font-size: 14px; color: #202020; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
            TouchArea { clicked => { root.cancelled(); } }
        }
        Rectangle {
            x: parent.width - 12px - 96px - 8px - 96px; y: parent.height - 50px;
            width: 96px; height: 34px;
            background: okta.has-hover ? root.accent.darker(0.2) : root.accent;
            border-radius: 3px;
            Text { text: @tr("确定"); font-size: 14px; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
            okta := TouchArea { clicked => { root.confirmed(); } }
        }
    }
}
