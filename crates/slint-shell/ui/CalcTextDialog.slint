// CalcTextDialog.slint — Calc 图形/文本框文字编辑(多行,回车换行,点确定提交)
import { DialogShell } from "DialogShell.slint";

export component CalcTextDialog inherits Rectangle {
    in-out property <bool> visible-dialog: false;
    in-out property <string> value-text: "";
    callback confirmed();
    callback cancelled();
    background: transparent;

    changed visible-dialog => {
        if (root.visible-dialog) { inp.focus(); inp.select-all(); }
    }

    DialogShell {
        accent: #217346;
        accent-hover: #185c37;
        visible-dialog <=> root.visible-dialog;
        title: @tr("编辑文字");
        card-width: 400px;
        card-height: 260px;
        confirm-enabled: true;
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }

        Text { x: 16px; y: 52px; text: @tr("文字内容(回车换行)"); font-size: 12px; font-weight: 600; color: #1a1a1a; }
        Rectangle {
            x: 16px; y: 74px; width: 368px; height: 110px;
            border-radius: 4px;
            border-width: 1px;
            border-color: inp.has-focus ? #217346 : #c0c0c0;
            background: #ffffff;
            inp := TextInput {
                x: 6px; y: 6px;
                width: parent.width - 12px;
                height: parent.height - 12px;
                font-size: 12px;
                color: #222222;
                single-line: false;
                wrap: word-wrap;
                text <=> root.value-text;
            }
        }
    }
}
