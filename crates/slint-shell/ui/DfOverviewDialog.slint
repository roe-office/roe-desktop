// DfOverviewDialog.slint — 导入文件前的数据集概览(类似 df.info() + df.head())
// 状态全在 Rust;确定 = 注册数据集并写预览 sheet,取消 = 什么都不注册。

import { ListView } from "std-widgets.slint";

export component DfOverviewDialog inherits Rectangle {
    in-out property <bool> visible-dialog: false;
    in property <string> title: "";
    in property <string> info-text: "";
    // 每行: [列名, 类型, 空值数, min, max, mean]
    in property <[[string]]> col-info: [];
    in property <[string]> head-cols: [];
    in property <[[string]]> head-rows: [];

    callback confirmed();
    callback cancelled();

    background: transparent;
    visible: root.visible-dialog;

    property <length> card-w: 860px;
    property <length> card-h: 580px;
    property <[length]> w: [200px, 100px, 80px, 110px, 110px, 110px];
    property <length> head-col-w: root.head-cols.length > 0
        ? max(110px, (root.card-w - 32px) / root.head-cols.length)
        : 100px;
    property <length> head-view-w: max(root.card-w, root.head-cols.length * root.head-col-w + 32px);

    Rectangle {
        width: parent.width; height: parent.height;
        background: #00000040;
        TouchArea { width: parent.width; height: parent.height; scroll-event(e) => { accept } }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.card-w; height: root.card-h;
        background: #ffffff;
        border-radius: 8px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000030;
        clip: true;

        TouchArea { width: parent.width; height: parent.height; }

        // 标题栏
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: 40px;
            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #e8e8e8; }
            Text {
                x: 16px; y: (parent.height - self.height) / 2;
                text: root.title; font-size: 14px; font-weight: 600; color: #1a1a1a;
            }
            close-touch := TouchArea {
                x: parent.width - 32px; y: (parent.height - 24px) / 2;
                width: 24px; height: 24px;
                clicked => { root.cancelled(); }
                Rectangle {
                    background: close-touch.has-hover ? #f0f0f0 : transparent;
                    border-radius: 4px;
                    Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: "×"; font-size: 16px; color: #666666; }
                }
            }
        }

        // 列信息表头
        Rectangle {
            x: 0px; y: 40px; width: parent.width; height: 28px;
            background: #f3f3f3;
            HorizontalLayout {
                x: 16px; width: parent.width - 32px;
                alignment: start;
                for h[i] in [@tr("列名"), @tr("类型"), @tr("空值数"), @tr("最小"), @tr("最大"), @tr("均值")]: Text {
                    width: root.w[i];
                    text: h; overflow: elide;
                    font-size: 12px; font-weight: 600; color: #1a1a1a;
                    vertical-alignment: center;
                }
            }
        }

        // 列信息行
        ListView {
            x: 0px; y: 68px;
            width: parent.width; height: 168px;
            for row in root.col-info: Rectangle {
                height: 24px;
                HorizontalLayout {
                    x: 16px; width: parent.width - 32px;
                    alignment: start;
                    for cell[i] in row: Text {
                        width: root.w[i];
                        text: cell; overflow: elide;
                        font-size: 12px; color: #333333;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 前 N 行
        Rectangle {
            x: 0px; y: 236px; width: parent.width; height: 24px;
            background: #fafafa;
            Text {
                x: 16px; y: (parent.height - self.height) / 2;
                text: @tr("前 10 行"); font-size: 12px; font-weight: 600; color: #666666;
            }
        }
        Rectangle {
            x: 0px; y: 260px; width: parent.width; height: 28px;
            background: #f3f3f3;
            clip: true;
            Flickable {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                interactive: false;
                viewport-width: root.head-view-w;
                viewport-x <=> head-list.viewport-x;
                HorizontalLayout {
                    x: 16px; width: root.head-view-w - 32px;
                    alignment: start;
                    for c in root.head-cols: Text {
                        width: root.head-col-w;
                        text: c; overflow: elide;
                        font-size: 12px; font-weight: 600; color: #1a1a1a;
                        vertical-alignment: center;
                    }
                }
            }
        }
        head-list := ListView {
            x: 0px; y: 288px;
            width: parent.width; height: parent.height - 288px - 48px;
            viewport-width: root.head-view-w;
            for row in root.head-rows: Rectangle {
                height: 24px;
                HorizontalLayout {
                    x: 16px; width: root.head-view-w - 32px;
                    alignment: start;
                    for cell in row: Text {
                        width: root.head-col-w;
                        text: cell; overflow: elide;
                        font-size: 12px; color: #333333;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 底部栏
        Rectangle {
            x: 0px; y: parent.height - 48px; width: parent.width; height: 48px;
            background: #fafafa;
            Rectangle { y: 0px; width: parent.width; height: 1px; background: #e8e8e8; }
            Text {
                x: 16px; y: (parent.height - self.height) / 2;
                text: root.info-text; font-size: 12px; color: #666666;
            }
            HorizontalLayout {
                x: parent.width - 16px - 220px; y: (parent.height - 28px) / 2;
                width: 220px; height: 28px;
                spacing: 8px; alignment: end;
                cancel-touch := TouchArea {
                    width: 64px; height: 28px;
                    clicked => { root.cancelled(); }
                    Rectangle {
                        border-radius: 4px; border-color: #c0c0c0; border-width: 1px;
                        background: cancel-touch.has-hover ? #f0f0f0 : #ffffff;
                        Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: @tr("取消"); font-size: 12px; color: #333333; }
                    }
                }
                ok-touch := TouchArea {
                    width: 88px; height: 28px;
                    clicked => { root.confirmed(); }
                    Rectangle {
                        border-radius: 4px;
                        background: ok-touch.has-hover ? #1a5c38 : #217346;
                        Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: @tr("导入并预览"); font-size: 12px; color: #ffffff; }
                    }
                }
            }
        }
    }
}
