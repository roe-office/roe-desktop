// DfPageDialog.slint — 前台数据集(parquet)只读分页预览
// 状态全在 Rust;这里只是视图。表格用 ListView + for 自绘,列宽均分。

import { ListView } from "std-widgets.slint";

export component DfPageDialog inherits Rectangle {
    in-out property <bool> visible-dialog: false;
    in property <string> title: "";
    in property <string> info-text: "";
    in property <[string]> col-names: [];
    in property <[[string]]> row-data: [];
    in property <bool> can-prev: false;
    in property <bool> can-next: false;

    callback prev();
    callback next();
    callback closed();

    background: transparent;
    visible: root.visible-dialog;

    property <length> card-w: 760px;
    property <length> card-h: 520px;
    property <length> col-w: root.col-names.length > 0
        ? max(80px, (root.card-w - 32px) / root.col-names.length)
        : 100px;

    // 遮罩(不响应点击关闭,避免误触丢失当前页)
    Rectangle {
        width: parent.width; height: parent.height;
        background: #00000040;
        TouchArea { width: parent.width; height: parent.height; scroll-event(e) => { accept } }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.card-w; height: root.card-h;
        background: #ffffff;
        border-radius: 8px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000030;
        clip: true;

        TouchArea { width: parent.width; height: parent.height; }

        // 标题栏
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: 40px;
            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #e8e8e8; }
            Text {
                x: 16px; y: (parent.height - self.height) / 2;
                text: root.title; font-size: 14px; font-weight: 600; color: #1a1a1a;
            }
            close-touch := TouchArea {
                x: parent.width - 32px; y: (parent.height - 24px) / 2;
                width: 24px; height: 24px;
                clicked => { root.closed(); }
                Rectangle {
                    background: close-touch.has-hover ? #f0f0f0 : transparent;
                    border-radius: 4px;
                    Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: "×"; font-size: 16px; color: #666666; }
                }
            }
        }

        // 表头
        Rectangle {
            x: 0px; y: 40px; width: parent.width; height: 28px;
            background: #f3f3f3;
            HorizontalLayout {
                x: 16px; width: parent.width - 32px;
                alignment: start;
                for c in root.col-names: Text {
                    width: root.col-w;
                    text: c; overflow: elide;
                    font-size: 12px; font-weight: 600; color: #1a1a1a;
                    vertical-alignment: center;
                }
            }
        }

        // 数据行
        ListView {
            x: 0px; y: 68px;
            width: parent.width; height: parent.height - 68px - 48px;
            for row in root.row-data: Rectangle {
                height: 24px;
                HorizontalLayout {
                    x: 16px; width: parent.width - 32px;
                    alignment: start;
                    for cell in row: Text {
                        width: root.col-w;
                        text: cell; overflow: elide;
                        font-size: 12px; color: #333333;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 底部栏:信息 + 上一页/下一页/关闭
        Rectangle {
            x: 0px; y: parent.height - 48px; width: parent.width; height: 48px;
            background: #fafafa;
            Rectangle { y: 0px; width: parent.width; height: 1px; background: #e8e8e8; }
            Text {
                x: 16px; y: (parent.height - self.height) / 2;
                text: root.info-text; font-size: 12px; color: #666666;
            }
            HorizontalLayout {
                x: parent.width - 16px - 240px; y: (parent.height - 28px) / 2;
                width: 240px; height: 28px;
                spacing: 8px; alignment: end;
                prev-touch := TouchArea {
                    width: 72px; height: 28px; enabled: root.can-prev;
                    clicked => { root.prev(); }
                    Rectangle {
                        border-radius: 4px; border-color: #c0c0c0; border-width: 1px;
                        background: root.can-prev && prev-touch.has-hover ? #f0f0f0 : #ffffff;
                        opacity: root.can-prev ? 1.0 : 0.45;
                        Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: @tr("上一页"); font-size: 12px; color: #333333; }
                    }
                }
                next-touch := TouchArea {
                    width: 72px; height: 28px; enabled: root.can-next;
                    clicked => { root.next(); }
                    Rectangle {
                        border-radius: 4px; border-color: #c0c0c0; border-width: 1px;
                        background: root.can-next && next-touch.has-hover ? #f0f0f0 : #ffffff;
                        opacity: root.can-next ? 1.0 : 0.45;
                        Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: @tr("下一页"); font-size: 12px; color: #333333; }
                    }
                }
                done-touch := TouchArea {
                    width: 64px; height: 28px;
                    clicked => { root.closed(); }
                    Rectangle {
                        border-radius: 4px;
                        background: done-touch.has-hover ? #1a5c38 : #217346;
                        Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: @tr("关闭"); font-size: 12px; color: #ffffff; }
                    }
                }
            }
        }
    }
}
