// ImpressRenameDialog.slint — Impress 母版视图「重命名版式」对话框（v320n）
import { DialogShell } from "DialogShell.slint";

export component ImpressRenameDialog inherits Rectangle {
    in-out property <bool> visible-dialog: false;
    in-out property <string> name-text: "";
    callback confirmed();
    callback cancelled();
    background: transparent;

    changed visible-dialog => {
        if (root.visible-dialog) { inp.focus(); inp.select-all(); }
    }

    DialogShell {
        accent: #c43e1c;
        accent-hover: #9e2f14;
        visible-dialog <=> root.visible-dialog;
        title: @tr("重命名版式");
        card-width: 360px;
        card-height: 180px;
        confirm-enabled: root.name-text != "";
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }

        Text { x: 16px; y: 52px; text: @tr("版式名称"); font-size: 12px; font-weight: 600; color: #1a1a1a; }
        Rectangle {
            x: 16px; y: 74px; width: 328px; height: 28px;
            border-radius: 4px;
            border-width: 1px;
            border-color: inp.has-focus ? #c43e1c : #c0c0c0;
            background: #ffffff;
            inp := TextInput {
                x: 6px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 12px;
                font-size: 12px;
                color: #222222;
                single-line: true;
                text <=> root.name-text;
                accepted => { if (root.name-text != "") { root.confirmed(); } }
            }
        }
    }
}
